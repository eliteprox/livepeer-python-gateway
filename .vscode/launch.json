{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Realtime: sd-turbo",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--generate-frames",
                "9000000",
                "--width",
                "512",
                "--height",
                "512",
                "--token",
                "${env:TOKEN}",
                "--app",
                "sd-turbo",
                "--preset",
                "neon-stage",
                "--fps",
                "15",
                "--output",
                "/tmp/e2e/sd-turbo-out.ts"
            ],
            "justMyCode": true
        },
        {
            "name": "Realtime: flux-klein",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                // "/tmp/e2e/clip.mp4",
                "--generate-frames",
                "9000000",
                "--width",
                "512",
                "--height",
                "512",
                "--token",
                "${env:TOKEN}",
                "--app",
                "flux-klein",
                "--preset",
                "cosmic",
                "--fps",
                "8",
                "--max-frames",
                "40",
                "--output",
                "/tmp/e2e/flux-klein-out.ts"
            ],
            "justMyCode": true
        },
        {
            "name": "Realtime: sd-turbo prompt",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--update",
                "--token",
                "${env:TOKEN}",
                "--app",
                "sd-turbo",
                "--prompt",
                "${input:sdTurboPrompt}"
            ],
            "justMyCode": true
        },
        {
            "name": "Realtime: flux-klein prompt",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--update",
                "--token",
                "${env:TOKEN}",
                "--app",
                "flux-klein",
                "--prompt",
                "${input:fluxKleinPrompt}",
                "--input-blend",
                "${input:fluxKleinBlend}"
            ],
            "justMyCode": true
        }
    ],
    "inputs": [
        {
            "id": "sdTurboPrompt",
            "type": "promptString",
            "description": "New sd-turbo prompt",
            "default": "a soft watercolor painting, flowing pastel colors, paper texture"
        },
        {
            "id": "fluxKleinPrompt",
            "type": "promptString",
            "description": "New flux-klein prompt",
            "default": "a neon-lit concert stage, laser beams, vivid magenta and cyan"
        },
        {
            "id": "fluxKleinBlend",
            "type": "promptString",
            "description": "flux-klein camera weight, 0 to 1",
            "default": "0.4"
        }
    ]
}
