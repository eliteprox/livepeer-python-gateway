{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Realtime: sd-turbo",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                "--generate-frames",
                "9000000",
                "--width",
                "512",
                "--height",
                "512",
                "--token",
                "${env:TOKEN}",
                "--app",
                "sd-turbo",
                "--preset",
                "neon-stage",
                "--fps",
                "15",
                "--output",
                "/tmp/e2e/sd-turbo-out.ts"
            ],
            "justMyCode": true
        },
        {
            "name": "Realtime: flux-klein",
            "type": "debugpy",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "program": "${workspaceFolder}/examples/realtime_client.py",
            "console": "integratedTerminal",
            "python": "/livepeer/ai/runner-app-examples/flux-klein/.venv/bin/python",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"
            },
            "args": [
                // "/tmp/e2e/clip.mp4",
                "--generate-frames",
                "9000000",
                "--width",
                "512",
                "--height",
                "512",
                "--token",
                "${env:TOKEN}",
                "--app",
                "flux-klein",
                "--preset",
                "cosmic",
                "--fps",
                "8",
                "--max-frames",
                "40",
                "--output",
                "/tmp/e2e/flux-klein-out.ts"
            ],
            "justMyCode": true
        }
    ]
}
